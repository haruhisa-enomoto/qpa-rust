#!/usr/bin/env python3
"""Generate searchable Python API and QPA provenance reference pages."""

from __future__ import annotations

import argparse
import ast
import html
import json
import sys
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[1]
STUB = REPO_ROOT / "python" / "qpa" / "_qpa.pyi"
LEDGER = REPO_ROOT / "porting" / "python-bindings.toml"
API_OUTPUT = REPO_ROOT / "docs" / "python" / "api-reference.md"
OPERATIONS_OUTPUT = REPO_ROOT / "docs" / "python" / "qpa-operation-index.md"


def annotation(node: ast.expr | None) -> str:
    return "None" if node is None else ast.unparse(node)


def signature(node: ast.FunctionDef, *, owner: str | None = None) -> str:
    clone = ast.FunctionDef(
        name=node.name,
        args=node.args,
        body=[ast.Pass()],
        decorator_list=[],
        returns=node.returns,
        type_comment=None,
    )
    ast.fix_missing_locations(clone)
    rendered = ast.unparse(clone).split(":\n", 1)[0]
    if owner is not None:
        rendered = rendered.replace(f"def {node.name}", f"def {owner}.{node.name}", 1)
    return rendered


def description(node: ast.AST) -> str | None:
    value = ast.get_docstring(node, clean=True)
    return value.replace("\n", " ") if value else None


def render_python_api() -> str:
    tree = ast.parse(STUB.read_text(encoding="utf-8"))
    functions = [node for node in tree.body if isinstance(node, ast.FunctionDef)]
    classes = [node for node in tree.body if isinstance(node, ast.ClassDef)]
    assignments = [
        node
        for node in tree.body
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name)
    ]
    method_count = sum(
        isinstance(item, ast.FunctionDef) for cls in classes for item in cls.body
    )

    lines = [
        "# Python API reference",
        "",
        "<!-- Generated by scripts/generate-python-docs; do not edit by hand. -->",
        "",
        "This page is generated from the shipped `qpa._qpa` type stub. It is the",
        "complete Python signature reference; the task-oriented guide explains the",
        "main mathematical workflows. For the originating GAP/QPA name and source",
        "file, use the [QPA operation index](qpa-operation-index.md).",
        "",
        f"The current surface contains {len(classes)} classes, {len(functions)} module-level functions,",
        f"and {method_count} class methods or properties.",
        "",
        "## Module constants",
        "",
    ]
    for node in assignments:
        lines.append(f"- `qpa.{node.target.id}: {annotation(node.annotation)}`")

    lines.extend(["", "## Module functions", ""])
    for node in functions:
        lines.extend([f"### `qpa.{node.name}`", ""])
        if doc := description(node):
            lines.extend([doc, ""])
        lines.extend(["```python", signature(node), "```", ""])

    lines.extend(["## Classes", ""])
    for cls in classes:
        lines.extend([f"### `qpa.{cls.name}`", ""])
        if doc := description(cls):
            lines.extend([doc, ""])
        bases = ", ".join(ast.unparse(base) for base in cls.bases)
        declaration = f"class {cls.name}({bases})" if bases else f"class {cls.name}"
        lines.extend(["```python", declaration, "```", ""])
        members = [item for item in cls.body if isinstance(item, ast.FunctionDef)]
        for member in members:
            decorators = {
                ast.unparse(decorator)
                for decorator in member.decorator_list
            }
            kind = "property" if "property" in decorators else "method"
            lines.extend(
                [
                    f"#### `{cls.name}.{member.name}` ({kind})",
                    "",
                ]
            )
            if doc := description(member):
                lines.extend([doc, ""])
            lines.extend(["```python", signature(member, owner=cls.name), "```", ""])

    return "\n".join(lines).rstrip() + "\n"


def parse_operation_ledger() -> list[dict[str, Any]]:
    operations: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    declared_count: int | None = None
    selected = {
        "qpa_name",
        "python_name",
        "disposition",
        "status",
        "python_target",
        "source_files",
        "deviations",
        "notes",
    }
    for raw_line in LEDGER.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if line.startswith("operation_count = "):
            declared_count = int(line.split(" = ", 1)[1])
            continue
        if line == "[[operations]]":
            if current is not None:
                operations.append(current)
            current = {}
            continue
        if current is None or not line or line.startswith("#") or " = " not in line:
            continue
        key, value = line.split(" = ", 1)
        if key in selected:
            current[key] = json.loads(value)
    if current is not None:
        operations.append(current)
    if declared_count is None:
        raise ValueError("operation_count is missing from the Python binding ledger")
    if len(operations) != declared_count:
        raise ValueError(
            f"parsed {len(operations)} operations, ledger declares {declared_count}"
        )
    return operations


def table_cell(value: str) -> str:
    return html.escape(value).replace("|", "&#124;").replace("\n", " ")


def source_links(sources: list[str]) -> str:
    links = []
    for source in sources:
        label = source.removeprefix("upstream/qpa/")
        links.append(f"[{table_cell(label)}](../../{source})")
    return "<br>".join(links)


def operation_section(name: str) -> str:
    if name and name[0].isalpha():
        return name[0].upper()
    if name and name[0].isdigit():
        return "0–9"
    return "Symbols"


def render_operation_index() -> str:
    operations = parse_operation_ledger()
    statuses = ["exposed", "represented", "unavailable", "partial", "planned"]
    status_summary = ", ".join(
        f"{sum(operation.get('status') == status for operation in operations)} `{status}`"
        for status in statuses
        if any(operation.get("status") == status for operation in operations)
    )
    lines = [
        "# GAP/QPA to Python operation index",
        "",
        "<!-- Generated by scripts/generate-python-docs; do not edit by hand. -->",
        "",
        "This index accounts for every grouped name in the pinned QPA operation",
        "ledger. It records the Python target and the QPA source files that remain",
        "the computational specification. The Python spelling is not evidence of an",
        "independently substituted algorithm.",
        "",
        f"Current grouped operation count: **{len(operations)}**.",
        f"Current dispositions: {status_summary}.",
        "",
    ]
    sections: dict[str, list[dict[str, Any]]] = {}
    for operation in operations:
        section = operation_section(str(operation.get("qpa_name", "")))
        sections.setdefault(section, []).append(operation)

    section_order = ["Symbols", "0–9", *"ABCDEFGHIJKLMNOPQRSTUVWXYZ"]
    for section in section_order:
        section_operations = sections.get(section, [])
        if not section_operations:
            continue
        lines.extend(
            [
                f"## {section}",
                "",
                "| GAP/QPA name | Python target | Status | QPA source | Port notes | Deviations |",
                "| --- | --- | --- | --- | --- | --- |",
            ]
        )
        for operation in section_operations:
            qpa_name = str(operation.get("qpa_name", ""))
            targets = str(operation.get("python_target", "")) or str(
                operation.get("python_name", "")
            )
            deviations = ", ".join(operation.get("deviations", [])) or "—"
            notes = str(operation.get("notes", "")) or "—"
            lines.append(
                "| `{}` | `{}` | {} | {} | {} | {} |".format(
                    table_cell(qpa_name),
                    table_cell(targets),
                    table_cell(str(operation.get("status", ""))),
                    source_links(operation.get("source_files", [])),
                    table_cell(notes),
                    table_cell(deviations),
                )
            )
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def update(path: Path, content: str, *, check: bool) -> bool:
    if check:
        actual = path.read_text(encoding="utf-8") if path.exists() else ""
        if actual != content:
            print(f"out of date: {path.relative_to(REPO_ROOT)}", file=sys.stderr)
            return False
        return True
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")
    print(path.relative_to(REPO_ROOT))
    return True


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--check", action="store_true", help="fail instead of rewriting stale output"
    )
    args = parser.parse_args()
    results = [
        update(API_OUTPUT, render_python_api(), check=args.check),
        update(OPERATIONS_OUTPUT, render_operation_index(), check=args.check),
    ]
    return 0 if all(results) else 1


if __name__ == "__main__":
    raise SystemExit(main())
