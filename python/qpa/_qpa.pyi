from __future__ import annotations


class QpaError(Exception): ...
class InvalidInputError(QpaError): ...
class RelationNotSatisfiedError(QpaError): ...


class Field:
    @staticmethod
    def rational() -> Field: ...
    @staticmethod
    def prime(characteristic: int) -> Field: ...
    @property
    def characteristic(self) -> int | None: ...
    @property
    def is_finite(self) -> bool: ...
    def element(self, numerator: int, denominator: int | None = None) -> Scalar: ...


class Scalar:
    @property
    def field(self) -> Field: ...
    @property
    def numerator(self) -> str | None: ...
    @property
    def denominator(self) -> str | None: ...
    @property
    def representative(self) -> int | None: ...


class Quiver:
    def __init__(
        self,
        vertices: list[str],
        arrows: list[tuple[str, str, str]],
    ) -> None: ...
    @property
    def vertices(self) -> list[str]: ...
    @property
    def arrows(self) -> list[tuple[str, str, str]]: ...
    def vertex_path(self, name: str) -> Path: ...
    def arrow_path(self, name: str) -> Path: ...
    def path(self, arrows: list[str]) -> Path: ...
    def zero_path(self) -> Path: ...
    def is_identical(self, other: Quiver) -> bool: ...


class Path:
    @property
    def length(self) -> int | None: ...
    @property
    def source(self) -> str | None: ...
    @property
    def target(self) -> str | None: ...
    @property
    def external_representation(self) -> list[int]: ...
    def multiply(self, right: Path) -> Path: ...
    def __mul__(self, right: Path) -> Path: ...


class PathAlgebra:
    def __init__(self, field: Field, quiver: Quiver) -> None: ...
    @property
    def field(self) -> Field: ...
    @property
    def quiver(self) -> Quiver: ...
    def generator(self, name: str) -> AlgebraElement: ...
    def term(self, path: Path, coefficient: Scalar) -> AlgebraElement: ...
    def zero(self) -> AlgebraElement: ...
    def one(self) -> AlgebraElement: ...
    def quotient(self, relations: list[AlgebraElement]) -> QuotientAlgebra: ...
    def module_from_integer_matrices(
        self,
        dimension_vector: list[int],
        actions: list[tuple[str, list[list[int]]]],
    ) -> MatrixModule: ...
    def is_identical(self, other: PathAlgebra) -> bool: ...


class AlgebraElement:
    @property
    def is_zero(self) -> bool: ...
    def add(self, right: AlgebraElement) -> AlgebraElement: ...
    def multiply(self, right: AlgebraElement) -> AlgebraElement: ...
    def pow(self, exponent: int) -> AlgebraElement: ...
    def __add__(self, right: AlgebraElement) -> AlgebraElement: ...
    def __mul__(self, right: AlgebraElement) -> AlgebraElement: ...


class QuotientAlgebra:
    @property
    def field(self) -> Field: ...
    def generator(self, name: str) -> QuotientElement: ...
    def zero(self) -> QuotientElement: ...
    def one(self) -> QuotientElement: ...
    def dimension(self) -> str | None: ...
    def is_identical(self, other: QuotientAlgebra) -> bool: ...


class QuotientElement:
    @property
    def is_zero(self) -> bool: ...
    @property
    def is_normal_form(self) -> bool: ...
    def add(self, right: QuotientElement) -> QuotientElement: ...
    def multiply(self, right: QuotientElement) -> QuotientElement: ...
    def __add__(self, right: QuotientElement) -> QuotientElement: ...
    def __mul__(self, right: QuotientElement) -> QuotientElement: ...


class MatrixModule:
    @property
    def dimension_vector(self) -> list[int]: ...
    @property
    def dimension(self) -> int: ...
    @property
    def arrow_matrix_shapes(self) -> list[tuple[int, int]]: ...
    def is_identical(self, other: MatrixModule) -> bool: ...
